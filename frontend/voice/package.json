{
  "name": "voice",
  "version": "2.0.0",
  "description": "Q1 Voice Agent frontend — bundles @vapi-ai/web for browser use",
  "private": true,
  "scripts": {
    "build": "npx esbuild vapi-entry.js --bundle --format=iife --global-name=VapiModule --outfile=vapi-bundle.js --minify --platform=browser",
    "build:watch": "npx esbuild vapi-entry.js --bundle --format=iife --global-name=VapiModule --outfile=vapi-bundle.js --platform=browser --watch"
  },
  "dependencies": {
    "@vapi-ai/web": "^2.7.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
