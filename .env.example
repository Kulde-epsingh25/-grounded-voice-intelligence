# ==============================================================================
# AI Engineer Assessment — Environment Variables
# ==============================================================================
# Copy to .env and fill in actual values.
# NEVER commit .env to version control.
# ==============================================================================

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# --- Vapi ---
# Required for browser calls: VAPI_PUBLIC_KEY + VAPI_ASSISTANT_ID from an existing Vapi assistant.
# Optional: VAPI_API_KEY is for server-side Vapi REST management; the browser SDK does not use it.
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# Set to the published app URL after publishing so Vapi can call the webhook.
PUBLIC_BASE_URL=

# --- Deepgram ---
DEEPGRAM_API_KEY=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_base

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Webhook Security ---
KB_WEBHOOK_SECRET=
# Set this in Replit and as the X-Vapi-Secret header in the Vapi assistant's server settings.
VAPI_WEBHOOK_SECRET=

RETRIEVAL_CONFIDENCE_THRESHOLD=0.60
RETRIEVAL_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Fallback Providers (Optional Free / Free-Tier) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.0-flash-exp
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

HF_TOKEN=
HF_LOCAL_ENABLED=true

# --- Forced Failure Simulation (Development / Testing Only) ---
MOCK_VAPI_FAILURE=false
MOCK_OPENAI_FAILURE=false
MOCK_DEEPGRAM_FAILURE=false
MOCK_ELEVENLABS_FAILURE=false
MOCK_GEMINI_FAILURE=false

